# Dependencies
node_modules/
.pnpm-store/

# Build output & TypeScript
dist/
*.tsbuildinfo

# Zensical docs build output (docs/ + zensical.toml -> site/, deployed to
# GitHub Pages by .github/workflows/docs.yml)
site/

# Test coverage
coverage/

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment / secrets (template/.env.example stays committed)
.env
.env.local
.env.*.local
.mise.local.toml

# Packaging — publishing is a manual step, never commit tarballs
*.tgz

# jj colocated VCS (when used alongside git)
.jj/

# Scratch / temporary files
tmp/
